# =====================================================================
# Upkeep 環境変数サンプル
# 本ファイルをコピーして `.env` を作成してください（.envはGit管理しません）
#   cp .env.example .env
# =====================================================================

# ---- Database (Phase 1) ----------------------------------------------
POSTGRES_USER=upkeep
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=upkeep
# Docker Compose内では db サービス名で名前解決されます。
# ローカルで `npm run dev` する場合は localhost:5432 に変更してください。
DATABASE_URL=postgresql://upkeep:change_me_strong_password@db:5432/upkeep

# ---- App (Phase 1) -----------------------------------------------------
NODE_ENV=production
TZ=Asia/Tokyo
PORT=3000

# ---- Auth (Phase 2 以降) ------------------------------------------------
# openssl rand -base64 32 で生成してください
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
# 初回 `npm run db:seed` 実行時にこのユーザーが作成されます
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ---- Web Push / VAPID (Phase 7) ----------------------------------------
# npx web-push generate-vapid-keys で生成してください
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# ブラウザ(クライアント)側にも公開鍵が必要なため NEXT_PUBLIC_ プレフィックスで複製します
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Scheduler (Phase 8) ------------------------------------------------
SCHEDULER_INTERVAL_MINUTES=5

# ---- Cloudflare Tunnel (Phase 9) -----------------------------------------
# Cloudflare Zero Trust ダッシュボードで発行したトンネルトークン
CLOUDFLARE_TUNNEL_TOKEN=
